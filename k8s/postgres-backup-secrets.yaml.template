---
# Garage S3 Credentials Secret Template for Postgres Backups
#
# IMPORTANT: This is a template file. Do not commit actual secrets to version control.
#
# This secret contains the S3-compatible credentials for accessing Garage storage.
# These credentials must be created via Garage admin API first.
#
# To create the actual secret:
# 1. Access a Garage pod to create access keys (if not already created):
#    kubectl exec -it garage-0 -n garage -- garage key new --name postgres-backup-key
#    This will output an access key ID and secret key.
#
# 2. Create the secret via kubectl:
#
# kubectl create secret generic s3-provider-credentials \
#   --from-literal=S3_PROVIDER_ACCESS_KEY='your-access-key-id-here' \
#   --from-literal=S3_PROVIDER_SECRET_KEY='your-secret-key-here' \
#   -n equal-risk
#
# Or create from this template by replacing the placeholder values below:
# Note: Values should be base64-encoded for the Secret data field.
# Generate base64 with: echo -n 'your-value' | base64
#
# Alternative: If you already have s3-provider-credentials in the garage namespace,
# you can copy it to equal-risk namespace:
# kubectl get secret s3-provider-credentials -n garage -o yaml | \
#   sed 's/namespace: garage/namespace: equal-risk/' | \
#   kubectl apply -f -
apiVersion: v1
kind: Secret
metadata:
  name: s3-provider-credentials
  namespace: equal-risk
type: Opaque
data:
  # Base64-encoded AWS access key ID for Garage
  # Generate with: echo -n 'your-access-key-id' | base64
  S3_PROVIDER_ACCESS_KEY: <BASE64_ENCODED_ACCESS_KEY_ID>
  # Base64-encoded AWS secret access key for Garage
  # Generate with: echo -n 'your-secret-key' | base64
  S3_PROVIDER_SECRET_KEY: <BASE64_ENCODED_SECRET_KEY>

