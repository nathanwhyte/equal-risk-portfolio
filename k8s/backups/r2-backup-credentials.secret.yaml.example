---
apiVersion: v1
kind: Secret
metadata:
  name: r2-backup-credentials
  namespace: equal-risk
type: Opaque
stringData:
  S3_PROVIDER_ENDPOINT: "https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com"
  S3_PROVIDER_ACCESS_KEY: "<R2_ACCESS_KEY_ID>"
  S3_PROVIDER_SECRET_KEY: "<R2_SECRET_ACCESS_KEY>"
